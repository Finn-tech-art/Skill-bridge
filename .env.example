# Environment variables
SECRET_KEY=your-secret-key-here

# MySQL Database Configuration — Aiven Cloud
# Get these values from your Aiven console at https://console.aiven.io
# Service name format: mysql-xxxxxxxx

# Option 1: Direct connection parameters (copy from Aiven console)
MYSQL_HOST=mysql.c.skillbridge.aivencloud.com
MYSQL_USER=avnadmin
MYSQL_PASSWORD=your-aiven-password-here
MYSQL_DB=defaultdb
MYSQL_PORT=21513

# Option 2: Connection string (alternative, not currently used but available)
# DATABASE_URL=mysql+pymysql://avnadmin:password@mysql.c.skillbridge.aivencloud.com:21513/defaultdb

# SSL Configuration (Aiven uses SSL by default)
MYSQL_USE_SSL=true
MYSQL_SSL_CA_PATH=./ca.pem

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=1
